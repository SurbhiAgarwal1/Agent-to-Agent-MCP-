{"id":null,"uid":"workflow-health","title":"COORDINATOR WORKFLOWS","schemaVersion":39,"version":1,"refresh":"15s","time":{"from":"now-1h","to":"now"},"panels":[{"id":1,"title":"Workflow outcomes","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":0,"y":0,"w":12,"h":8},"targets":[{"expr":"sum by (status) (rate(workflow_requests_total[5m]))","legendFormat":"{{status}}","refId":"A"}]},{"id":2,"title":"Failed workflows / second","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":12,"y":0,"w":12,"h":8},"targets":[{"expr":"sum(rate(workflow_errors_total[5m]))","legendFormat":"errors","refId":"A"}]},{"id":3,"title":"Workflow p95 latency (ms)","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":0,"y":8,"w":12,"h":8},"targets":[{"expr":"histogram_quantile(0.95, sum by (le, status) (rate(workflow_duration_milliseconds_bucket[5m])))","legendFormat":"{{status}}","refId":"A"}]},{"id":4,"title":"Agent errors / second","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":12,"y":8,"w":12,"h":8},"targets":[{"expr":"sum by (agent) (rate(agent_errors_total[5m]))","legendFormat":"{{agent}}","refId":"A"}]}]}

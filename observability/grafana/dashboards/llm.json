{"id":null,"uid":"llm-usage","title":"LLM REASONING","schemaVersion":39,"version":1,"refresh":"15s","time":{"from":"now-1h","to":"now"},"panels":[{"id":1,"title":"Requests / second by provider and model","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":0,"y":0,"w":12,"h":8},"targets":[{"expr":"sum by (provider, model) (rate(llm_requests_total{status=\"success\"}[5m]))","legendFormat":"{{provider}} / {{model}}","refId":"A"}]},{"id":2,"title":"Errors / second","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":12,"y":0,"w":12,"h":8},"targets":[{"expr":"sum by (provider, model) (rate(llm_errors_total[5m]))","legendFormat":"{{provider}} / {{model}}","refId":"A"}]},{"id":3,"title":"LLM p95 latency (ms)","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":0,"y":8,"w":12,"h":8},"targets":[{"expr":"histogram_quantile(0.95, sum by (le, provider, model) (rate(llm_request_duration_milliseconds_bucket[5m])))","legendFormat":"{{provider}} / {{model}}","refId":"A"}]},{"id":4,"title":"Provider-reported tokens","type":"timeseries","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":12,"y":8,"w":12,"h":8},"targets":[{"expr":"sum(llm_input_tokens_total)","legendFormat":"input","refId":"A"},{"expr":"sum(llm_output_tokens_total)","legendFormat":"output","refId":"B"},{"expr":"sum(llm_total_tokens_total)","legendFormat":"total","refId":"C"}]}]}

APP_NAME="Blood Donation Matching System"
ENVIRONMENT="development"
DEBUG=True
HOST="127.0.0.1"
PORT=8000
DATABASE_URL="sqlite:///./blood_donation.db"

# JWT Secret Key (REQUIRED: Must be at least 32 characters long)
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Shared private-network credential (32+ characters) used only by A2A and MCP service clients.
# Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SERVICE_TO_SERVICE_TOKEN=

# LLM reasoning provider. Mock is deterministic, free, and needs no API key.
LLM_PROVIDER=mock
LLM_FALLBACK_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_RETRIES=2

# Internal observability stack (only Docker Compose publishes loopback-bound UIs).
OBSERVABILITY_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=prometheus
OTEL_LOGS_EXPORTER=none
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Allowed CORS Origins (comma-separated URLs, no wildcards allowed)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000"

# Local admin bootstrap: set a strong secret to enable ADMIN self-registration.
# Leave empty in production to disable public ADMIN registration.
ADMIN_SIGNUP_KEY=

# Minimum days between a donor's donations (default 56). Confirm with your clinical lead.
# DONOR_MIN_GAP_DAYS=56

# Independent synthetic data API databases and MCP HTTP client configuration
BLOOD_BANK_DATABASE_URL=sqlite:///./data/blood_bank_data.db
DONOR_DATABASE_URL=sqlite:///./data/donor_data.db
BLOOD_BANK_API_URL=http://127.0.0.1:8105
DONOR_API_URL=http://127.0.0.1:8106
DATA_API_TIMEOUT_SECONDS=8
DATA_API_MAX_RETRIES=2
DATA_APIS_ENABLED=true
NOTIFICATION_CHANNEL=console
NOTIFICATION_PUBLIC_BASE_URL=http://localhost:8105
NOTIFICATION_PUBLIC_DONOR_URL=http://localhost:8106
NOTIFICATION_WEBHOOK_TOKEN=
NOTIFICATION_RESPONSE_TOKEN_TTL_SECONDS=86400
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
